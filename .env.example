# Pyrite Secrets & Optional Environment Overrides
# Non-secret settings (chain, RPCs, thresholds, MEV-Share, CUDA solver) can live cleanly in `pyrite.json`.
# Keep private keys STRICTLY in `.env` (`chmod 0600`) — NEVER put them in `pyrite.json`.

# Searcher burner wallet private key (hex with or without 0x). Run `pyrite init-wallet` or use the Write-Only Wallet tab.
PRIVATE_KEY=

# Optional comma-separated worker EOA private keys for multi-EOA concurrency (`setCallers`)
EXTRA_PRIVATE_KEYS=

# Optional dedicated Flashbots X-Flashbots-Signature auth key (falls back to PRIVATE_KEY)
FLASHBOTS_AUTH_KEY=

# Optional overrides (take precedence over `pyrite.json` if set and non-empty)
# CHAIN=eth
# PYRITE_CONFIG=pyrite.json
# EXECUTOR_ADDRESS_ETH=
# EXECUTOR_ADDRESS_BSC=
# EXECUTOR_ADDRESS_BASE=
# RPC_URLS=
# WS_RPC_URLS=
# BROADCAST_RPC_URLS=
# BUNDLE_RPC_URLS=
# MEV_SHARE_ENABLED=true
# SOLVER_MODE=cpu
# RUST_LOG=info
